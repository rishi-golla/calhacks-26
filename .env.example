# Copy to .env and fill in. Never commit .env.
OUTREACH_MODE=demo                 # the only allowed mode at the event
DEMO_ALLOWLIST_PHONES=+15555550100,+15555550101
DEMO_ALLOWLIST_EMAILS=team@example.com

HARNESS_URL=http://localhost:8000
SPACETIME_URL=http://localhost:3000
SPACETIME_DB=freightops
POSTGRES_URL=postgresql+asyncpg://freight:freight@localhost:5432/freight
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=https://your-tunnel.example.com

MOCK_INTEGRATIONS=0                # 1 = canned data for offline tests only
SEC_USER_AGENT="Golden Gate Freight (Cal Hacks) you@example.com"   # SEC EDGAR asks for a contact
SOCRATA_APP_TOKEN=                 # optional: higher FMCSA census rate limit
SIM_TIME_RATIO=1800                # business seconds per wall second (1800: 1 s = 30 business min)
SIM_LOAD_INTERVAL_S=8              # mean seconds between new loads
SIM_MAX_OPEN_HUMAN_ITEMS=3         # cap on parked calls/emails before the sim only plants clean loads
SIM_WARM_START_LOADS=12            # loads backfilled at startup, already mid-lifecycle
CARTESIA_API_KEY=
VOICE_PROVIDER=mock                # cartesia = live outbound dialing (still routed to the allowlist)
CARTESIA_WEBHOOK_SECRET=
GATEWAY_TOKEN=                     # leave empty and make live generates one per run; set it to keep a fixed token
CARTESIA_FROM_NUMBER_ID=
APIFY_TOKEN=
CONTEXT_DEV_API_KEY=
CONTACT_DATA_API_KEY=
CRS_API_KEY=
NESSIE_API_KEY=
