# Copy to .env and fill in. Never commit .env.
OUTREACH_MODE=demo                 # the only allowed mode at the event
DEMO_ALLOWLIST_PHONES=+15555550100,+15555550101
DEMO_ALLOWLIST_EMAILS=team@example.com

HARNESS_URL=http://localhost:8000
SPACETIME_URL=http://localhost:3000
SPACETIME_DB=freightops
SPACETIME_DISABLED=1              # set 0 and load per-service credentials for live W2 writes
SPACETIME_TOKEN=                  # optional fallback; prefer SPACETIME_TOKEN_<AGENT>
SPACETIME_ACTOR=                  # only needed by legacy call_reducer; strict clients set actor
SPACETIME_TIMEOUT_SECONDS=5
# Browser config belongs in web/.env.local. Never expose service tokens as NEXT_PUBLIC_*.
# NEXT_PUBLIC_SPACETIME_URL=ws://127.0.0.1:3000
# NEXT_PUBLIC_SPACETIME_DB=freightops
POSTGRES_URL=postgresql+asyncpg://freight:freight@localhost:5432/freight
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=https://your-tunnel.example.com

MOCK_INTEGRATIONS=1
CARTESIA_API_KEY=
CARTESIA_WEBHOOK_SECRET=
CARTESIA_FROM_NUMBER_ID=
APIFY_TOKEN=
CONTEXT_DEV_API_KEY=
CONTACT_DATA_API_KEY=
CRS_API_KEY=
NESSIE_API_KEY=

# A2A execution: fixture requires no model credentials and is labeled simulated.
FREIGHTOPS_MODE=fixture
SOURCE_DATA_PATH=sim/fixtures/brokerage_source.json
A2A_RUNTIME_DIR=data/a2a
A2A_DATABASE_URL=                 # optional override; live defaults to POSTGRES_URL
A2A_CONCURRENCY=4

# Required for live model inference. Select exact model IDs available to your accounts.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ALLOWED_AGENT_MODELS=             # optional comma-separated provider/model catalog for UI overrides
# Optional overrides: AGENT_PROVIDER_CARRIER_AP, AGENT_MODEL_CARRIER_AP, AGENT_URL_CARRIER_AP.
# Repeat for any service ID. Live requires distinct nonempty A2A tokens for all eleven identities.
A2A_TOKEN_CARRIER_AP=
A2A_TOKEN_SHIPPER_AR=
A2A_TOKEN_CFO=
A2A_TOKEN_RISK=
A2A_TOKEN_CONTROLLER=
A2A_TOKEN_VERIFICATION=
A2A_TOKEN_VOICE_DESK=
A2A_TOKEN_VALIDATOR=
A2A_TOKEN_DOCUMENTS=
A2A_TOKEN_ROUTER=
A2A_TOKEN_GATEWAY=
GATEWAY_API_TOKEN=

# Cartesia hosted agent/persona IDs. Set up disclosure, callback and tool auth in each persona.
CARTESIA_AGENT_ID_VERIFICATION=
CARTESIA_AGENT_ID_COLLECTIONS=
CARTESIA_AGENT_ID_APPROVALS=
CARTESIA_AGENT_ID_CASH_BRIEF=
OUTREACH_TIMEZONE=America/Los_Angeles
OUTREACH_START_HOUR=8
OUTREACH_END_HOUR=18
