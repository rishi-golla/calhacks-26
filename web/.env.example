# Browser-visible connection coordinates only. NEVER put a service token in NEXT_PUBLIC_*.
NEXT_PUBLIC_SPACETIME_URL=http://localhost:3000
NEXT_PUBLIC_SPACETIME_DB=freightops

# Server-side fallback coordinates (may differ when Next runs behind a proxy).
SPACETIME_URL=http://localhost:3000
SPACETIME_DB=freightops

# W4 owns the real handlers. Keep disabled until those handlers are ready.
GATEWAY_URL=http://localhost:9000
DEMO_GATEWAY_ENABLED=false
DEMO_ALLOWLIST_PHONES=
DEMO_ALLOWLIST_EMAILS=

# Source documents the evidence viewer serves read-only (server-side only). Defaults to
# $SIM_DATA_DIR/{docs,mail}, where a relative SIM_DATA_DIR is taken from the repo root exactly
# as the Python services take it (so SIM_DATA_DIR=data means <repo>/data). DOCS_DIR and
# MAIL_DIR, when set, are taken relative to web/.
# DOCS_DIR=../data/docs
# MAIL_DIR=../data/mail
# Minutes of append-only history (audit events, doc reads; on /ops also change sets,
# cell changes, outbox, LLM calls) the dashboard keeps live. Default 15; 0 keeps all.
# Case pages always load their own case in full.
NEXT_PUBLIC_LIVE_WINDOW_MINUTES=15
