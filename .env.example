# Copy to .env and fill in. Never commit .env.
OUTREACH_MODE=demo                 # the only allowed mode at the event
DEMO_ALLOWLIST_PHONES=+15555550100,+15555550101
DEMO_ALLOWLIST_EMAILS=team@example.com

HARNESS_URL=http://localhost:8000
SPACETIME_URL=http://localhost:3000
SPACETIME_DB=freightops
POSTGRES_URL=postgresql+asyncpg://freight:freight@localhost:5432/freight
REDIS_URL=redis://localhost:6379/0
PUBLIC_BASE_URL=https://your-tunnel.example.com

MOCK_INTEGRATIONS=1
CARTESIA_API_KEY=
CARTESIA_WEBHOOK_SECRET=
GATEWAY_TOKEN=                     # required header x-gateway-token for dashboard/demo/approval calls
CARTESIA_FROM_NUMBER_ID=
APIFY_TOKEN=
CONTEXT_DEV_API_KEY=
CONTACT_DATA_API_KEY=
CRS_API_KEY=
NESSIE_API_KEY=
