# Copy to .env and fill in. Never commit .env.
OUTREACH_MODE=demo                 # the only allowed mode at the event
DEMO_ALLOWLIST_PHONES=+15555550100,+15555550101
DEMO_ALLOWLIST_EMAILS=team@example.com

HARNESS_URL=http://localhost:8000
SPACETIME_URL=http://localhost:3000
SPACETIME_DB=freightops
SPACETIME_DISABLED=1              # set 0 and load per-service credentials for live W2 writes
SPACETIME_TOKEN=                  # optional fallback; prefer SPACETIME_TOKEN_<AGENT>
SPACETIME_ACTOR=                  # only needed by legacy call_reducer; strict clients set actor
SPACETIME_TIMEOUT_SECONDS=5
# Browser config belongs in web/.env.local. Never expose service tokens as NEXT_PUBLIC_*.
# NEXT_PUBLIC_SPACETIME_URL=ws://127.0.0.1:3000
# NEXT_PUBLIC_SPACETIME_DB=freightops
POSTGRES_URL=postgresql+asyncpg://freight:freight@localhost:5432/freight
REDIS_URL=redis://localhost:6379/0
RAW_STREAM=raw
EVENTS_STREAM=events
DOCUMENTS_STREAM=documents
PUBLIC_BASE_URL=https://your-tunnel.example.com

MOCK_INTEGRATIONS=1
SEC_USER_AGENT="Golden Gate Freight (Cal Hacks) you@example.com"
SOCRATA_APP_TOKEN=
SIM_TIME_RATIO=1800
SIM_LOAD_INTERVAL_S=8
SIM_MAX_OPEN_HUMAN_ITEMS=3
SIM_WARM_START_LOADS=12
SIM_HISTORY_DAYS=90
SIM_HISTORY_LOADS=120
SIM_DATA_DIR=data
SIM_DATA_MAX_MB=500
SIM_KEEP_LOADS=2000
CARTESIA_API_KEY=
CARTESIA_WEBHOOK_SECRET=          # optional completion webhook only; polling does not require it
CARTESIA_FROM_NUMBER_ID=
# Live lookups need PUBLIC_BASE_URL pointing at the read-only gateway on :9001.
# Attach hosted tools with setup_cartesia --apply --update-existing --enable-tools.
# Completion remains local polling; do not tunnel the operator gateway on :9000.
CARTESIA_WEBHOOK_TOOLS_ENABLED=0
# Local Demo Console: same server-only token in the gateway profile and web/.env.local.
# Keep disabled until the private SYN-CARTESIA-TEAM-CALL case and team destination are prepared.
DEMO_PHONE_ENABLED=0
DEMO_CONTROL_TOKEN=
APIFY_TOKEN=
# Reviewed actor schemas and pinned builds. Other actors require their own adapter.
APIFY_FMCSA_ACTOR_ID=humble-echidna/fmcsa-carrier-check
APIFY_FMCSA_BUILD=0.1.2
APIFY_CONTACT_ACTOR_ID=vdrmota/contact-info-scraper
APIFY_CONTACT_BUILD=0.2.242
# Deferred: CRS/Nessie and other enrichment providers are not enabled in the current milestone.
CONTEXT_DEV_API_KEY=
CONTACT_DATA_API_KEY=
CRS_API_KEY=
NESSIE_API_KEY=

# A2A execution: fixture requires no model credentials and is labeled simulated.
FREIGHTOPS_MODE=fixture
SOURCE_DATA_PATH=sim/fixtures/brokerage_source.json
A2A_RUNTIME_DIR=data/a2a
A2A_DATABASE_URL=                 # optional override; live defaults to POSTGRES_URL
A2A_CONCURRENCY=4

# OpenAI alone can run all nine agents. Model access is checked with your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Use a separate model for Settlement Quality Review; approvals remain enforced by code.
AGENT_MODEL_VALIDATOR=gpt-6.1-sol
# Optional: only needed for an explicit AGENT_PROVIDER_<ID>=anthropic override.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ALLOWED_AGENT_MODELS=             # optional comma-separated provider/model catalog for UI overrides
# Optional overrides: AGENT_PROVIDER_CARRIER_AP, AGENT_MODEL_CARRIER_AP, AGENT_URL_CARRIER_AP.
# Repeat for any service ID. Live requires distinct nonempty A2A tokens for all eleven identities.
A2A_TOKEN_CARRIER_AP=
A2A_TOKEN_SHIPPER_AR=
A2A_TOKEN_CFO=
A2A_TOKEN_RISK=
A2A_TOKEN_CONTROLLER=
A2A_TOKEN_VERIFICATION=
A2A_TOKEN_VOICE_DESK=
A2A_TOKEN_VALIDATOR=
A2A_TOKEN_DOCUMENTS=
A2A_TOKEN_ROUTER=
A2A_TOKEN_GATEWAY=
GATEWAY_API_TOKEN=

# Cartesia hosted agent/persona IDs. Set up disclosure, callback and tool auth in each persona.
CARTESIA_AGENT_ID_VERIFICATION=
CARTESIA_AGENT_ID_COLLECTIONS=
CARTESIA_AGENT_ID_APPROVALS=
CARTESIA_AGENT_ID_CASH_BRIEF=
OUTREACH_TIMEZONE=America/Los_Angeles
OUTREACH_START_HOUR=8
OUTREACH_END_HOUR=18
